# ================================================================
# SENKORA - Environment Variables Template
# .env olarak kopyalayip degerleri doldurun
# .env asla Git'e eklenmez
# ================================================================

# --- Database ---
DB_CONNECTION_STRING=Server=localhost,1433;Database=SenkoraDb;User Id=sa;Password=LOGO;TrustServerCertificate=True;

# --- Redis ---
REDIS_CONNECTION_STRING=localhost:6379

# --- JWT (minimum 64 karakter) ---
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHAR_KEY_IN_PRODUCTION_DO_NOT_USE_THIS
JWT_ISSUER=https://api.senkora.io
JWT_AUDIENCE=https://senkora.io
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# --- Encryption Key (32 bytes base64) ---
ENCRYPTION_KEY=ZGV2X29ubHlfa2V5X3RoaXNfaXNfMzJfYnl0ZXMhISE=

# --- Seq ---
SEQ_URL=http://localhost:5341

# --- Licensing ---
LICENSE_SERVER_URL=https://license.senkora.io

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@senkora.io

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
PORTAL_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
